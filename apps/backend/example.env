# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bookmark

# Better Auth
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=your-secret-here

# Frontend URL
UI_URL=http://localhost:3001

# API documentation (optional)
# Swagger UI (/api/docs) and the OpenAPI document (/api/docs-json) are served
# outside production by default. Set to true to keep them on in production.
SWAGGER_ENABLED=false

# OIDC Configuration (optional)
OIDC_ENABLED=false
OIDC_ISSUER_URL=https://auth.example.com
OIDC_CLIENT_ID=bookmark
OIDC_CLIENT_SECRET=your-client-secret

# Content Requests / Tracker Client (optional)
# Enable users to search and request content from a torrent tracker.
TRACKER_CLIENT_URL=http://localhost:8080
TRACKER_CLIENT_API_KEY=your-tracker-client-api-key

# Metrics endpoint (optional)
# When enabled, serves metrics in the open Prometheus exposition format on a
# separate internal port (http://<host>:9464/metrics) — never on the public
# API. Most monitoring stacks can scrape it directly. Leave disabled unless
# you run one.
METRICS_ENABLED=false
METRICS_PORT=9464
# Optional hardening for the metrics endpoint:
# - METRICS_TOKEN: require `Authorization: Bearer <token>` on every scrape
#   (recommended when anything other than the container itself can reach the
#   port, e.g. a shared Docker network).
# - METRICS_HOST: interface to bind, e.g. 127.0.0.1. By default the metrics
#   server binds all interfaces (which is what cross-container scraping needs).
# METRICS_TOKEN=
# METRICS_HOST=127.0.0.1
