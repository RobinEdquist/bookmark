{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "dev": "nest start --watch",
    "debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "check-types": "tsc --noEmit",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --forceExit",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:cov": "NODE_OPTIONS=--experimental-vm-modules jest --coverage --forceExit",
    "test:debug": "NODE_OPTIONS=--experimental-vm-modules node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "openapi:export": "nest build && node dist/src/scripts/export-openapi.js"
  },
  "dependencies": {
    "@better-auth/api-key": "1.6.23",
    "@napi-rs/canvas": "^1.0.2",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/platform-socket.io": "^11.1.28",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/websockets": "^11.1.28",
    "@thallesp/nestjs-better-auth": "^2.7.0",
    "@types/pg": "^8.20.0",
    "archiver": "^7.0.1",
    "bcrypt": "^6.0.0",
    "better-auth": "^1.6.23",
    "better-sqlite3": "^12.11.1",
    "cheerio": "^1.2.0",
    "chokidar": "^5.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie": "^2.0.1",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "epub2": "^3.0.2",
    "express": "^5.2.1",
    "fast-xml-parser": "^5.10.1",
    "graphql": "^17.0.2",
    "graphql-request": "^7.4.0",
    "mediainfo.js": "^0.3.7",
    "nestjs-pino": "^4.6.1",
    "node-unrar-js": "^2.0.2",
    "p-limit": "^7.3.0",
    "pdfjs-dist": "^6.1.200",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "playwright": "^1.61.1",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.3",
    "socket.io": "^4.8.3",
    "undici": "^8.8.0",
    "unzipper": "^0.12.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.28",
    "@testcontainers/postgresql": "^12.0.4",
    "@types/archiver": "^7.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cookie": "^1.0.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.1",
    "@types/supertest": "^7.2.1",
    "@types/unzipper": "^0.10.11",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.7.0",
    "jest": "^30.4.2",
    "pdf-lib": "^1.17.1",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.5",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "testcontainers": "^12.0.4",
    "ts-jest": "^29.4.11",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.64.0",
    "zod": "^4.3.6"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "setupFilesAfterEnv": [
      "<rootDir>/__test-utils__/silence-logger.ts"
    ],
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleNameMapper": {
      "^@test-utils/(.*)$": "<rootDir>/__test-utils__/$1",
      "^@test-utils$": "<rootDir>/__test-utils__/"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s",
      "!**/*.spec.ts",
      "!**/__tests__/**",
      "!**/__test-utils__/**",
      "!**/*.module.ts",
      "!**/*.dto.ts",
      "!**/dto/**",
      "!**/*.schema.ts",
      "!**/schema.ts",
      "!**/*.types.ts",
      "!**/types/**",
      "!**/*.d.ts",
      "!**/index.ts",
      "!**/*.constants.ts",
      "!**/*enums.ts",
      "!**/theme-config.ts",
      "!main.ts",
      "!app.module.ts",
      "!swagger.ts",
      "!scripts/**",
      "!../drizzle/**",
      "!../apps/**"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
