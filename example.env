# =============================================================================
# Bookmark - Environment Configuration
# =============================================================================
# Copy this file to .env and configure for your deployment
#
# Run with the pre-built image:
#   docker compose up -d
#
# Or build from source:
#   docker compose -f docker-compose.yml -f docker-compose.build.yml up -d --build
#
# For a local try-out on http://localhost:3001 you don't have to set anything -
# an auth secret is generated on first start and all URLs default to localhost.

# =============================================================================
# Deployment Configuration (required for anything beyond localhost)
# =============================================================================

# The public URL where the application is accessible
# Used for auth callbacks and CORS configuration
# Default: http://localhost:3001
PUBLIC_URL=https://bookmark.example.com

# Authentication secret - generate with: openssl rand -base64 32
# If unset, one is generated on first start and persisted in the app data volume
BETTER_AUTH_SECRET=change-me-to-a-secure-secret

# =============================================================================
# Database Configuration
# =============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-to-a-secure-password
POSTGRES_DB=bookmark

# =============================================================================
# Data Paths
# =============================================================================
# Base path for application data (postgres, covers, cache)
# Defaults to ./data if not set
DATA_PATH=./data

# Mount paths to your audiobook, ebook, and comic libraries
# These are read-only mounts - the app won't modify your files.
# Exception: AI-generated audiobooks are written to a "generated" folder
# inside the audiobook library, backed by DATA_PATH/generated-audiobooks.
# Note: a pre-existing "generated" folder in your audiobook library would be
# shadowed by this mount.
AUDIOBOOK_LIBRARY_PATH=/path/to/your/audiobooks
EBOOK_LIBRARY_PATH=/path/to/your/ebooks
COMIC_LIBRARY_PATH=/path/to/your/comics

# =============================================================================
# OIDC / SSO Configuration (optional)
# =============================================================================
# Enable OIDC authentication (requires restart to change)
OIDC_ENABLED=false

# Your identity provider's issuer URL (e.g., Authentik, Keycloak, Authelia)
# Example: https://auth.example.com/application/o/bookmark/
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# =============================================================================
# Content Requests / Tracker Client (optional)
# =============================================================================
# Enable users to search and request content from a torrent tracker.
# Requires a running tracker client API that exposes the gateway endpoints
# (/search, /download, /torrents, /image).
TRACKER_CLIENT_URL=
TRACKER_CLIENT_API_KEY=

# =============================================================================
# AI-narrated audiobooks / Text-to-speech (optional)
# =============================================================================
# No env vars needed - the TTS integration is configured at runtime in
# Settings -> Integrations. Any OpenAI-compatible speech server works; a
# ready-to-use engine ships behind a compose profile and starts with:
#   docker compose --profile tts up -d
# It is reachable from the app container at http://tts:8880 (enter that as
# the server URL in settings). Generated audiobooks are stored under
# DATA_PATH/generated-audiobooks and show up in the audiobook library in a
# "generated" folder.

# =============================================================================
# Image Configuration
# =============================================================================
# Which Bookmark image to run (ignored when building from source).
# `latest` tracks the newest release; `edge` follows the main branch.
# BOOKMARK_IMAGE=ghcr.io/robinedquist/bookmark:latest

# Host port to expose the app on (default: 3001)
# PORT=3001

# =============================================================================
# Update Checks (optional)
# =============================================================================
# Once every 6 hours the app asks GitHub whether a newer release exists, and
# shows a marker in the sidebar if so. This is a plain GET of a public endpoint
# — no telemetry, and nothing about your instance or library is sent — but it is
# still an outbound request, so set this to false to switch it off entirely.
# UPDATE_CHECK_ENABLED=true

# Repository to check releases against. Only useful if you run a fork.
# UPDATE_CHECK_REPO=RobinEdquist/bookmark
