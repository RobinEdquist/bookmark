{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  // TZ is read per-request by the server at runtime, so it must reach tasks but
  // must not affect build hashes - the compiled output is identical either way
  "globalPassThroughEnv": ["TZ"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "out/**"],
      "env": ["API_URL", "WEBSITE_BASE_PATH"]
    },
    "lint": {
      "dependsOn": ["^lint"],
      "env": ["NODE_ENV"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "jest.config.*", "vitest.config.*", "vitest.setup.*", "**/*.spec.ts", "**/*.test.ts", "**/*.test.tsx"],
      "env": ["NODE_ENV"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
